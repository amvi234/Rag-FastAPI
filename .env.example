# LLM Provider (Optional - default: openai)
# Set to "fake" to test /ingest and /ask end-to-end with deterministic stub
# data, without calling OpenAI or needing an API key.
LLM_PROVIDER=openai

# OpenAI API Configuration (Required when LLM_PROVIDER=openai)
# Get API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your_key_here

# OpenAI Model Selection (Optional - defaults provided)
# For chat/answer generation (default: gpt-5.5)
# Recommended options: gpt-4-turbo, gpt-4o, gpt-3.5-turbo
OPENAI_CHAT_MODEL=gpt-5.5

# For text embeddings (default: text-embedding-3-small)
# Recommended options: text-embedding-3-small (fast, cheap), text-embedding-3-large (better quality)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ChromaDB Configuration (Optional - defaults provided)
# Path to store vector database (default: ./chroma)
CHROMA_PATH=./chroma

# Collection name for documents (default: rag_docs)
COLLECTION_NAME=rag_docs
